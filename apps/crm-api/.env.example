# Copy to .env. Docker Compose reads this file; local Start.ps1 does not.
CRM_DOMAIN=sales.example.com
# Generate random hexadecimal text, never reuse the TFSC database password.
CRM_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_BEFORE_STARTING
# Optional combined deployment (compose.combined.yaml):
TFSC_DOMAIN=agreements.example.com
TFSC_POSTGRES_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_BEFORE_STARTING
TFSC_CRM_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Existing separate TFSC server, for standalone compose.yaml:
CRM_TFSC_URL=https://agreements.example.com
# Google Calendar is optional. Generate Fernet key with cryptography.fernet.Fernet.generate_key().
CRM_ENCRYPTION_KEY=
CRM_GOOGLE_CLIENT_ID=
CRM_GOOGLE_CLIENT_SECRET=
# Optional shared identity provider; use separate registered clients for the two sites.
CRM_OIDC_ISSUER=
CRM_OIDC_CLIENT_ID=
CRM_OIDC_CLIENT_SECRET=
TFSC_OIDC_ISSUER=
TFSC_OIDC_CLIENT_ID=
TFSC_OIDC_CLIENT_SECRET=
