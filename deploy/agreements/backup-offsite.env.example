# Optional off-site backup repository (pgBackRest repo2). Copy to backup-offsite.env (never commit it) and fill in; the
# postgres and backup services read it. Every WAL file and backup then also goes to this S3-compatible bucket
# (HTTPS only), encrypted with its own passphrase. Use a bucket on another provider/region than this server, with
# versioning or object lock, and keys that cannot delete objects if the provider supports that.
PGBACKREST_REPO2_TYPE=s3
PGBACKREST_REPO2_PATH=/tfsc
PGBACKREST_REPO2_S3_BUCKET=
PGBACKREST_REPO2_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
PGBACKREST_REPO2_S3_REGION=eu-central-1
PGBACKREST_REPO2_S3_KEY=
PGBACKREST_REPO2_S3_KEY_SECRET=
# path for most S3-compatible services other than AWS
PGBACKREST_REPO2_S3_URI_STYLE=host
PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO2_CIPHER_PASS=
PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
PGBACKREST_REPO2_RETENTION_FULL=35
