{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfsc.example/contracts/agreements-integration/v1/meta.schema.json",
  "title": "Meta v1",
  "type": "object",
  "required": ["contract", "contract_revision", "instance_id", "head_seq", "published_clients", "generated_at"],
  "properties": {
    "contract": {"const": "tfsc.agreements.integration/1"},
    "contract_revision": {"type": "integer", "minimum": 1, "description": "Raised by one for every additive change to v1. Informational."},
    "agreements_release": {"type": "string"},
    "instance_id": {"type": "string"},
    "head_seq": {"type": "integer", "minimum": 0},
    "published_clients": {"type": "integer", "minimum": 0, "description": "How many clients currently have a published snapshot."},
    "state_digest": {"type": "string", "description": "SHA-256 over the sorted list of client_ref:snapshot_hash. Lets a consumer prove it holds the same state."},
    "last_sweep_at": {"type": ["string", "null"], "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
