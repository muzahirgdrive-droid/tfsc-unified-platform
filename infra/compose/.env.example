# Copy to .env and fill. Never commit .env. Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(32))"
CRM_MODE=hosted
CRM_ORIGIN=https://crm.example.com
TFSC_MODE=hosted
TFSC_ORIGIN=https://agreements.example.com
SSO_PUBLIC_URL=https://sso.example.com
CRM_DOMAIN=crm.example.com
TFSC_DOMAIN=agreements.example.com
SSO_DOMAIN=sso.example.com
FILES_DOMAIN=files.example.com
FILES_PUBLIC_URL=https://files.example.com
POSTGRES_PASSWORD=
CRM_PHONE_KEY_SECRET=
# base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CRM_FIELD_KEY=
BRIDGE_SECRET=
CRM_OIDC_CLIENT_SECRET=
TFSC_OIDC_CLIENT_SECRET=
# Keycloak service-account secret (required): the CRM creates SSO accounts and Keycloak emails the invitations
CRM_KEYCLOAK_CLIENT_SECRET=
# Outgoing mail for invitations and password resets (trial: `--profile trial` runs Mailpit, the defaults point at it)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=24-7 Consultancy
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
# start (production) or start-dev (local trial)
KC_COMMAND=start
KC_REALM_SSL_REQUIRED=external
# 1 only while bootstrapping the first Super Admin; SSO is the normal sign-in.
CRM_ALLOW_LOCAL_LOGIN=0
CRM_METRICS_TOKEN=
# Object storage (bundled RustFS service `objects`): access key + a long random secret
S3_ACCESS_KEY=tfsc-crm
S3_SECRET_KEY=
# Upload virus scan: clamd host:port (bundled service `clamav`), or "off" to accept unscanned uploads
CRM_CLAMAV=clamav:3310
# Observability (`--profile observability`): Grafana admin password; traces to Jaeger with
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318 (empty = no tracing). Sentry DSNs are optional.
GRAFANA_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
CRM_SENTRY_DSN=
CRM_SENTRY_DSN_WEB=
TFSC_SENTRY_DSN=
